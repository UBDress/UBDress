<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>UBDress | Catálogo</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      background: #080808;
      color: white;
    }

    button {
      font-family: inherit;
      cursor: pointer;
    }

    /* ================= HEADER ================= */

    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(8, 8, 8, 0.95);
      backdrop-filter: blur(15px);
      border-bottom: 1px solid #242424;
    }

    .header {
      max-width: 1400px;
      margin: auto;
      min-height: 75px;
      padding: 15px 25px;

      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
    }

    .logo {
      font-size: 28px;
      font-weight: 900;
      letter-spacing: 2px;
      white-space: nowrap;
    }

    .logo span {
      color: #777;
    }

    .search {
      flex: 1;
      max-width: 550px;
      position: relative;
    }

    .search input {
      width: 100%;
      padding: 14px 45px 14px 18px;

      background: #151515;
      border: 1px solid #303030;
      border-radius: 30px;

      color: white;
      outline: none;
      font-size: 14px;
    }

    .search input:focus {
      border-color: #777;
    }

    .search-icon {
      position: absolute;
      right: 18px;
      top: 50%;
      transform: translateY(-50%);
      color: #888;
    }

    /* ================= HERO ================= */

    .hero {
      max-width: 1400px;
      min-height: 420px;
      margin: 25px auto;

      padding: 50px;

      border: 1px solid #272727;
      border-radius: 20px;

      display: flex;
      align-items: center;

      background:
        linear-gradient(
          90deg,
          rgba(0,0,0,.95),
          rgba(0,0,0,.45)
        ),
        linear-gradient(
          135deg,
          #242424,
          #050505
        );
    }

    .hero-content {
      max-width: 650px;
    }

    .hero h1 {
      font-size: clamp(48px, 8vw, 90px);
      line-height: .9;
      font-weight: 900;
      letter-spacing: -3px;
      margin-bottom: 25px;
    }

    .hero p {
      color: #aaa;
      font-size: 17px;
      line-height: 1.6;
      margin-bottom: 30px;
    }

    .hero-button {
      padding: 14px 25px;

      background: white;
      color: black;

      border: none;
      border-radius: 7px;

      font-weight: bold;
    }

    /* ================= CONTENIDO ================= */

    .container {
      max-width: 1400px;
      margin: auto;
      padding: 30px 25px 80px;
    }

    .section-title {
      font-size: 28px;
      margin-bottom: 20px;
    }

    /* ================= CATEGORÍAS ================= */

    .categories {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 12px;
      margin-bottom: 50px;
    }

    .category {
      min-height: 120px;

      background: #151515;
      border: 1px solid #292929;
      border-radius: 12px;

      color: white;
      font-size: 16px;
      font-weight: bold;

      transition: .2s;
    }

    .category:hover,
    .category.active {
      background: white;
      color: black;
      transform: translateY(-3px);
    }

    /* ================= MARCAS ================= */

    .brands {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 45px;
    }

    .brand {
      padding: 11px 18px;

      background: #151515;
      border: 1px solid #303030;
      border-radius: 25px;

      color: white;
      font-size: 14px;

      transition: .2s;
    }

    .brand:hover,
    .brand.active {
      background: white;
      color: black;
    }

    /* ================= PRODUCTOS ================= */

    .products-header {
      display: flex;
      justify-content: space-between;
      align-items: center;

      margin-bottom: 20px;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .product {
      overflow: hidden;

      background: #141414;
      border: 1px solid #292929;
      border-radius: 13px;

      transition: .2s;
    }

    .product:hover {
      transform: translateY(-5px);
      border-color: #555;
    }

    .product-image {
      width: 100%;
      height: 300px;

      background: #202020;

      display: flex;
      align-items: center;
      justify-content: center;

      overflow: hidden;
    }

    .product-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .no-image {
      color: #666;
      font-size: 12px;
      text-align: center;
      padding: 20px;
    }

    .product-info {
      padding: 16px;
    }

    .brand-name {
      color: #888;
      font-size: 12px;
      text-transform: uppercase;
      margin-bottom: 7px;
      letter-spacing: 1px;
    }

    .product-name {
      font-size: 17px;
      font-weight: bold;
      margin-bottom: 15px;
    }

    .whatsapp-button {
      width: 100%;
      padding: 13px;

      background: #25D366;
      color: white;

      border: none;
      border-radius: 7px;

      font-size: 13px;
      font-weight: bold;

      transition: .2s;
    }

    .whatsapp-button:hover {
      background: #20b957;
      transform: scale(1.02);
    }

    /* ================= SIN RESULTADOS ================= */

    .no-results {
      grid-column: 1 / -1;

      padding: 80px 20px;

      text-align: center;
      color: #777;
    }

    /* ================= FOOTER ================= */

    footer {
      padding: 45px 25px;

      background: #050505;
      border-top: 1px solid #222;

      text-align: center;
      color: #666;
    }

    footer strong {
      color: white;
    }

    /* ================= MÓVIL ================= */

    @media (max-width: 1000px) {

      .products {
        grid-template-columns: repeat(3, 1fr);
      }

      .categories {
        grid-template-columns: repeat(3, 1fr);
      }

    }

    @media (max-width: 700px) {

      .header {
        flex-wrap: wrap;
      }

      .logo {
        font-size: 22px;
      }

      .search {
        order: 3;
        flex-basis: 100%;
      }

      .hero {
        margin: 15px;
        padding: 45px 25px;
        min-height: 350px;
      }

      .hero h1 {
        font-size: 55px;
      }

      .container {
        padding: 25px 15px 60px;
      }

      .categories {
        grid-template-columns: repeat(2, 1fr);
      }

      .products {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
      }

      .product-image {
        height: 220px;
      }

      .product-info {
        padding: 12px;
      }

      .product-name {
        font-size: 14px;
      }

    }

    @media (max-width: 400px) {

      .product-image {
        height: 190px;
      }

      .hero h1 {
        font-size: 45px;
      }

      .category {
        min-height: 100px;
      }

    }

  </style>
</head>

<body>


<!-- ================= CABECERA ================= -->

<header>

  <div class="header">

    <div class="logo">
      UB<span>DRESS</span>
    </div>

    <div class="search">

      <input
        type="text"
        id="searchInput"
        placeholder="Buscar producto o marca..."
        oninput="searchProducts()"
      >

      <span class="search-icon">⌕</span>

